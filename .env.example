# PostgreSQL, UTF-8. Local dev: `pnpm db:up` starts one on port 5433.
DATABASE_URL=postgres://abcfinance:abcfinance@127.0.0.1:5433/abcfinance

# 32 random bytes, base64. Encrypts leads, 2FA secrets and email bodies, and keys hashes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it makes encrypted data unreadable. Back it up separately from the database.
APP_SECRET=

# Public address of the panel host. Used for links in email; never taken from the request.
# Required in production.
APP_URL=http://localhost:3000

# Bearer secret for POST /api/cron/deemed (the scheduled job).
CRON_SECRET=

# SMTP connection, e.g. smtps://user:pass@smtp.example.com. Without it, mail stays queued.
SMTP_URL=
MAIL_FROM="abcfinance <no-reply@abcfinance.test>"

# 1 also emails invitations. Off: the admin copies the one-time link and sends it themselves
# (D58). The link is shown to the admin either way.
INVITE_EMAILS=0

# 1 turns on "Forgot your password?" and admins' reset links. They need email, so they stay off
# until SMTP is set up (D58; M6).
PASSWORD_RESET=0

# Seconds between a view and an engaged read the server accepts (default 15).
ENGAGED_MIN_SECONDS=15

# In-memory cache lifetimes in seconds (default 30). Tests set 0.
TENANT_CACHE_SECONDS=30
WIDGET_CACHE_SECONDS=30

# Development only: 1 shows labelled placeholder boxes in ad slots.
ADS_PREVIEW=0

# Development only (`next dev`): 1 accepts the code 111111 for two-step set-up and sign-in, so
# demo accounts sign in without an authenticator app. Ignored by production builds, and the
# server refuses to start if it is set in production (D41).
DEV_TOTP_BYPASS=0

# 1 when the app runs behind nginx, which sets X-Real-IP. The app must then only be reachable
# through nginx (bind to 127.0.0.1), or clients could forge their address.
TRUST_PROXY=0
